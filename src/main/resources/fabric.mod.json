{
  "schemaVersion": 1,
  "id": "easymine",
  "version": "${version}",
  "name": "Easy Mine",
  "description": "Client-side mining helper: record every key, click and camera movement as a route, then replay it while you hold left click.",
  "authors": ["nlin1027"],
  "license": "LicenseRef-All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.easymine.EasyMineClient"
    ]
  },
  "accessWidener": "easymine.classtweaker",
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
